#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define NUM 3
#define ADJUST 4
#define MAGNET 5
#define EXTRA 6

// Magnet (macOS window manager) shortcuts are all Ctrl+Option+<key>
#define MG(k) &kp LC(LA(k))
#define MGD(k) &kp LC(LA(LG(k)))

/ {

  behaviors {
    // Relays the active layer to the right half so it can paint its per-key RGB (see src/layer_leds.c).
    // The node name is limited to 8 characters because it is sent over the split link.
    lyrleds: lyrleds {
      compatible = "custom,behavior-layer-leds";
      #binding-cells = <1>;
    };

    // Tap: one-shot MAGNET layer. Hold: momentary EXTRA layer (placeholder for now).
    magnet_ht: magnet_tap_hold {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "tap-preferred";
      tapping-term-ms = <200>;
      bindings = <&mo>, <&sl>;
    };

    // Encoder behavior: clockwise = brighter, counter-clockwise = dimmer
    // (this board's encoders report reversed, same as the volume bindings use VOL_DN first)
    rgb_enc: rgb_encoder {
      compatible = "zmk,behavior-sensor-rotate";
      #sensor-binding-cells = <0>;
      bindings = <&rgb_ug RGB_BRD>, <&rgb_ug RGB_BRI>;
    };
  };

  // Activate ADJUST layer by pressing raise and lower
  conditional_layers {
    compatible = "zmk,conditional-layers";
    adjust_layer {
      if-layers = <LOWER RAISE>;
      then-layer = <ADJUST>;
    };
  };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "default";
      // ------------------------------------------------------------------------------------------------------------
      // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
      // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
      // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
      // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  | PLAY  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
      //               | CTRL | OPT | CMD  | LOWER|  ENTER |  | SPACE | RAISE| NUM   | MAGNET| CTRL |
      bindings = <
        &kp GRAVE &kp N1 &kp N2   &kp N3   &kp N4    &kp N5                           &kp N6 &kp N7    &kp N8    &kp N9   &kp N0   &kp GRAVE
        &kp ESC   &kp Q  &kp W    &kp E    &kp R     &kp T                            &kp Y  &kp U     &kp I     &kp O    &kp P    &kp BSPC
        &kp TAB   &kp A  &kp S    &kp D    &kp F     &kp G                            &kp H  &kp J     &kp K     &kp L    &kp SEMI &kp SQT
        &kp LSHFT &kp Z  &kp X    &kp C    &kp V     &kp B   &kp C_MUTE &kp C_PLAY    &kp N  &kp M     &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
        &kp LCTRL &kp LALT &kp LGUI &mo LOWER  &kp RET    &kp SPACE  &mo RAISE  &tog NUM &magnet_ht EXTRA MAGNET  &kp RCTRL
      >;

      sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_PREV C_NEXT>;
    };

    lower_layer {
      display-name = "lower";
      // ------------------------------------------------------------------------------------------------------------
      // |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
      // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  F12  |
      // |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
      // |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
      //               |     |      |      |      |        |  |       |      |       |       |      |
      bindings = <
        &trans    &kp F1    &kp F2    &kp F3      &kp F4    &kp F5                    &kp F6    &kp F7   &kp F8    &kp F9    &kp F10   &kp F11
        &kp GRAVE &kp N1    &kp N2    &kp N3      &kp N4    &kp N5                    &kp N6    &kp N7   &kp N8    &kp N9    &kp N0    &kp F12
        &trans    &kp EXCL  &kp AT    &kp HASH    &kp DLLR  &kp PRCNT                 &kp CARET &kp AMPS &kp ASTRK &kp LPAR  &kp RPAR  &kp PIPE
        &trans    &kp EQUAL &kp MINUS &kp PLUS &kp LBRC  &kp RBRC   &trans &trans  &kp LBKT  &kp RBKT &kp SEMI  &kp COLON &kp BSLH  &trans
        &trans    &trans      &trans    &trans     &trans &trans  &trans    &trans   &trans    &trans
      >;

      sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_PREV C_NEXT>;
    };

    raise_layer {
      display-name = "raise";
      // ------------------------------------------------------------------------------------------------------------
      // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
      // |       | SCRN | SCRN | CTRL  | SELALL| REDO |                | PGUP | LINE<|   ^   | LINE>|       |       |
      // |       | OPT  | CMD  | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
      // |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
      // SCRN = Cmd+Shift+3 (full) / Cmd+Shift+4 (selection); LINE< / LINE> = Cmd+Left / Cmd+Right
      //                |      |       |       |      |      |  |      |      |      |       |      |
      bindings = <
        &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                  &trans    &trans    &trans   &trans    &trans  &trans
        &trans     &kp LG(LS(N3)) &kp LG(LS(N4)) &kp LCTRL &kp LG(A)  &kp LG(LS(Z))                &kp PG_UP &kp LG(LEFT) &kp UP &kp LG(RIGHT) &kp N0 &trans
        &trans     &kp LALT     &kp LGUI     &kp LSHFT    &trans       &kp CLCK                      &kp PG_DN &kp LEFT  &kp DOWN &kp RIGHT &kp DEL &kp BSPC
        &trans     &kp LG(Z)   &kp LG(X)    &kp LG(C)    &kp LG(V)    &studio_unlock        &trans  &trans  &trans    &trans    &trans   &trans    &trans  &trans
        &trans       &trans       &trans       &trans        &trans  &trans  &trans    &trans    &trans   &trans
      >;

      sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_PREV C_NEXT>;
    };

    num_layer {
      display-name = "num";
      // ------------------------------------------------------------------------------------------------------------
      // |       |     |     |      |      |      |                   |  +   |  7    |  8    |  9   |   -   |       |
      // |       |     |     |      |      |      |                   |  *   |  4    |  5    |  6   |   /   | BKSPC |
      // |       |     |     |      |      |      |                   |  ^   |  1    |  2    |  3   |   %   | ENTER |
      // |       |     |     |      |      |      |        |  |       |  (   |  0    |       |  .   |   )   |   =   |
      //               |     |      |      |      |        |  |       |      |  NUM  |       |      |
      // Sticky: the NUM key on the base layer toggles this layer on/off (press it again to leave)
      // Grow ops (+ * ^) left of the digits, shrink ops (- / %) right of them
      bindings = <
        &trans &trans &trans &trans &trans &trans                    &kp PLUS  &kp N7 &kp N8   &kp N9  &kp MINUS &trans
        &trans &trans &trans &trans &trans &trans                    &kp ASTRK &kp N4 &kp N5   &kp N6  &kp FSLH  &kp BSPC
        &trans &trans &trans &trans &trans &trans                    &kp CARET &kp N1 &kp N2   &kp N3  &kp PRCNT &kp RET
        &trans &trans &trans &trans &trans &trans &trans &trans      &kp LPAR  &kp N0 &none    &kp DOT &kp RPAR  &kp EQUAL
        &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
      >;
    };

    adjust_layer {
      // ----------------------------------------------------------------------------------------------------------------------------
      // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
      // | EXTPWR |         | RGB_HUD | RGB_HUI | RGB_EFF |         |                  |      |      |       |      |       |       |
      // |        |         | RGB_BRD | RGB_BRI | RGB_TOG |         |                  |      |      |       |      |       |       |
      // |  BOOT  |         | RGB_SAD | RGB_SAI |         |         | RGB_TOG | |      |      |      |       |      |       |  BOOT |
      // BOOT = &bootloader: resets the half whose key you press into UF2 mode (no pin needed)
      //                    |         |         |         |         |         | |      |      |      |       |      |
      display-name = "adjust";
      bindings = <
        &bt BT_CLR        &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4                            &none &none &none &none &none &none
        &ext_power EP_TOG &none           &rgb_ug RGB_HUD &rgb_ug RGB_HUI &rgb_ug RGB_EFF &none                                   &none &none &none &none &none &none
        &none             &none           &rgb_ug RGB_BRD &rgb_ug RGB_BRI &rgb_ug RGB_TOG &none                                   &none &none &none &none &none &none
        &bootloader       &none           &rgb_ug RGB_SAD &rgb_ug RGB_SAI &none           &none            &rgb_ug RGB_TOG &none  &none &none &none &none &none &bootloader
        &none           &none           &none           &none            &none           &none  &none &none &none &none
      >;

      // Left encoder: RGB brightness (click toggles RGB, see RGB_TOG above); right encoder unchanged
      sensor-bindings = <&rgb_enc &inc_dec_kp C_PREV C_NEXT>;
    };

    magnet_layer {
      display-name = "magnet";
      // ------------------------------------------------------------------------------------------------------------
      // One-shot: tap the MAGNET key, then press one key below (Ctrl+Opt+key is sent). Letters match Magnet's own.
      // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
      // |       |     | L1/3| C1/3 | R1/3 |      |                   |      |  TL   |  TOP  |  TR  |       | RSTOR |
      // |       |     | L2/3| C2/3 | R2/3 |      |                   |      | LEFT  | BOTTOM| RIGHT|       |       |
      // |       |PREVD|NEXTD|CENTER|      |      |        |  |       |      |  BL   |       |  BR  |       |       |
      //               |     |      |      |  MAX |        |  |       |      |       |       |      |
      // Halves use the same keys as the arrows on the RAISE layer (I = up, J/K/L = left/down/right)
      bindings = <
        &trans &trans &trans &trans &trans &trans                    &trans   &trans &trans &trans    &trans &trans
        &trans &trans MG(D)  MG(F)  MG(G)  &trans                    &trans   MG(U)  MG(UP) MG(I)     &trans MG(BSPC)
        &trans &trans MG(E)  MG(R)  MG(T)  &trans                    &trans   MG(LEFT) MG(DOWN) MG(RIGHT) &trans &trans
        &trans MGD(LEFT) MGD(RIGHT) MG(C) &trans &trans   &trans &trans   &trans MG(J)  &trans MG(K)  &trans &trans
        &trans &trans &trans &trans MG(RET)  &trans &trans &trans &trans &trans
      >;
    };

    extra_layer {
      display-name = "extra";
      // Placeholder for the MAGNET key's hold action; everything falls through to the layers below
      bindings = <
        &trans &trans &trans &trans &trans &trans                    &trans &trans &trans &trans &trans &trans
        &trans &trans &trans &trans &trans &trans                    &trans &trans &trans &trans &trans &trans
        &trans &trans &trans &trans &trans &trans                    &trans &trans &trans &trans &trans &trans
        &trans &trans &trans &trans &trans &trans &trans &trans      &trans &trans &trans &trans &trans &trans
        &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
      >;
    };
  };
};
